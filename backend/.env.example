# Server Config
PORT=8000
ENVIRONMENT=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster1.ki46oil.mongodb.net/?appName=Cluster1
DATABASE_NAME=geosentinel

# Security
JWT_SECRET=super-secret-jwt-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GATEWAY_API_KEY=geosentinel_gw_secret_key
ALLOW_ANONYMOUS_INGEST=true

# Third-party APIs
SMS_API_KEY=your_fast2sms_or_twilio_key
WEATHER_API_KEY=your_openweathermap_key

# Risk Thresholds
RISK_THRESHOLD_ADVISORY=40
RISK_THRESHOLD_WARNING=60
RISK_THRESHOLD_CRITICAL=80
